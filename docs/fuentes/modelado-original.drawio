        <mxCell id="YDxWGrfLzZ9dvYhf1SfJ-132" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;fontColor=#FF0000;" value="Métodos que operan peticiones GET/POST desde el formnulario de IGU_Cliente&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Tambipen oueden ser métodos de un EndPoint de un API interno del sistema, que es invocado desde el front-end&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="110" x="1280" y="1620" as="geometry" />
        </mxCell>
        <mxCell id="guvO3VTvWYWkWDmPEX39-1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#663300;" value="&lt;b&gt;&lt;u&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Nota:&lt;/font&gt;&lt;/u&gt;&lt;/b&gt;&lt;div&gt;Cada CUS debe tener su diagrama de clases en el análisis y su diagrama de clases en el diseño.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Además:&lt;/div&gt;&lt;div&gt;Debe haber un diagrama general de clases del análisis y un diagrama general de clases del diseño.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="170" x="1035" y="1896" as="geometry" />
        </mxCell>
