<mxfile host="app.diagrams.net" pages="3"><diagram id="p0" name="1. Arquitectura en capas"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Comunidades Virtuales — Arquitectura en capas" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Actores + Navegador&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Estudiante · Docente · Administrador&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="160" y="80" width="620" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;IGU (vistas / Thymeleaf)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;IGU_Perfil · IGU_Comunidades · IGU_Recursos · IGU_GestionContenido · IGU_Notificaciones · IGU_Seguridad&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="160" y="190" width="620" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Controladores&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;PortalController (vistas)  +  REST Controllers (/api/...)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="160" y="300" width="620" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Servicios&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Interfaces Service + ServiceImpl  ·  DTOs Request / Response  ·  ApiMapper&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=8;" ver