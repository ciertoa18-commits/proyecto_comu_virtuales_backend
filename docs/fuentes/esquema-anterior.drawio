as="offset"/></mxGeometry></mxCell><mxCell id="c56" value="&lt;b&gt;Decisiones de unificación&lt;/b&gt;&lt;br&gt;• Se usa &lt;b&gt;Usuario&lt;/b&gt; (tabla T_PERSONA) en lugar de Persona / Cuenta.&lt;br&gt;• La solicitud de ingreso es su propia entidad; al aprobarse se crea MiembroComunidad.&lt;br&gt;• Usuario incluye estadoCuenta e intentosFallidos para el bloqueo (CU13)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="560" width="320" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3. Componentes por módulo"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Componentes por módulo (casos de uso)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Módulo / CU&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="170" height="34" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;IGU&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="70" width="190" height="34" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Controlador&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="200" height="34" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Servicio&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;