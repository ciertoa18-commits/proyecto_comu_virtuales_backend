ont&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="410" width="220" height="70" as="geometry"/></mxCell><mxCell id="c16" value="CorreoServiceSMTP → JavaMailSender" style="endArrow=block;endFill=1;html=1;dashed=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;" edge="1" parent="1" source="c7" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Flujo típico de una petición&lt;/b&gt;&lt;br&gt;1. Navegador → PortalController (GET vista)&lt;br&gt;2. IGU → RESTController (GET/POST/PATCH /api)&lt;br&gt;3. Controller → ServiceImpl (reglas, validación)&lt;br&gt;4. ServiceImpl → Repository → Oracle&lt;br&gt;5. Respuesta HTTP 200 / 201 / 403 + DTO" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="300" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2. Modelo de dominio"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Modelo de dominio unificado (CU01–CU13)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Usuario" style="swimlane;fontStyle=1;align=center;startSize=26;html=1;whiteSpace=wrap;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="250" as="geometry"/></mxCell><mxCell id="c5" value="- id: Long (PK)&lt;br&gt;- nombreCompleto: String&lt;br&gt;- email: String&lt;br&gt;- passwordHash: String&lt;br&gt;- fotoPerfilUrl: St