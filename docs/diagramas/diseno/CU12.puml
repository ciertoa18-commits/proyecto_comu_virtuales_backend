@startuml
title CU12 Gestionar notificaciones — Diseño
left to right direction
class ComunicacionController {
  + notifications(int, int): Page
  + read(Long): void
  + send(MensajeDatos): Mensaje
}
class Requests <<DTO validado>>
class NotificationService {
  + send(destino, tipo, entidad): void
  + broadcast(comunidad, tipo, entidad): void
  + list(int, int): Page<Notificacion>
  + read(Long): void
  + readAll(): void
}
ComunicacionController --> NotificationService
ComunicacionController ..> Requests
interface UsuarioRepository <<JpaRepository>> {
 + findById(Long): Optional<Usuario>
 + save(Usuario): Usuario
}
class Usuario <<entity>> {
  - idUsuario : Long
  - idRol : Long
  - correo : String
  - nombres : String
  - apellidos : String
  - especialidad : String
  - keycloakSub : String
  - passwordHash : String
  - intentosFallidos : Long
  - bloqueadoHasta : LocalDateTime
  - idFotoPerfil : Long
  - idIdiomaPref : Long
  - estado : UsuarioEstado
  - fechaRegistro : LocalDateTime
  - fechaActualizacion : LocalDateTime
}
NotificationService --> UsuarioRepository
UsuarioRepository ..> Usuario
interface NotificacionRepository <<JpaRepository>> {
 + findById(Long): Optional<Notificacion>
 + save(Notificacion): Notificacion
}
class Notificacion <<entity>> {
  - idNotificacion : Long
  - idDestinatario : Long
  - idEmisor : Long
  - idComunidad : Long
  - tipo : NotificacionTipo
  - titulo : String
  - contenido : String
  - entidadTipo : String
  - entidadId : Long
  - leida : Boolean
  - fechaCreacion : LocalDateTime
  - fechaLectura : LocalDateTime
}
NotificationService --> NotificacionRepository
NotificacionRepository ..> Notificacion
@enduml
