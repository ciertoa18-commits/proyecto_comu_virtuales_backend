  - fechaEnvio : LocalDateTime
  - eliminado : Boolean
}
class Auditoria <<entity>> {
  - idAuditoria : Long
  - tabla : String
  - idRegistro : Long
  - accion : AuditoriaAccion
  - idUsuario : Long
  - fecha : LocalDateTime
  - valoresAntes : String
  - valoresDespues : String
}
