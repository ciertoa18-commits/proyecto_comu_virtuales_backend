@startuml
title Diagrama general de clases de diseño
hide empty methods
skinparam linetype ortho
class Rol <<entity>> {
  - idRol : Long
  - codigo : RolCodigo
  - nombre : String
}
class Categoria <<entity>> {
  - idCategoria : Long
  - nombre : String
  - descripcion : String
}
class Idioma <<entity>> {
  - idIdioma : Long
  - codigo : String
  - nombre : String
}
class PuebloOriginario <<entity>> {
  - idPueblo : Long
  - nombre : String
  - familiaLinguistica : String
}
class Usuario <<entity>> {
  - idUsuario : Long
  - idRol : Long
  - correo : String
  - nombres : String
  - apellidos : String
  - especialidad : String
  - keycloakSub : String
  - passwordHash : String
  - intentosFallidos : Long
  - bloqueadoHasta : LocalDateTime
  - idFotoPerfil : Long
  - idIdiomaPref : Long
  - estado : UsuarioEstado
  - fechaRegistro : LocalDateTime
  - fechaActualizacion : LocalDateTime
}
class Archivo <<entity>> {
  - idArchivo : Long
  - idSubidoPor : Long
  - nombreOriginal : String
  - extension : String
  - tipoMime : String
  - tamanoBytes : Long
  - rutaAlmacenamiento : String
  - fechaSubida : LocalDateTime
}
class Comunidad <<entity>> {
  - idComunidad : Long
  - nombre : String
  - descripcion : String
  - idCategoria : Long
  - idIdioma : Long
  - idPueblo : Long
  - visibilidad : ComunidadVisibilidad
  - moderacionPrevia : Boolean
  - estado : ComunidadEstado
  - idImagen : Long
  - idCreador : Long
  - fechaCreacion : LocalDateTime
  - fechaActualizacion : LocalDateTime
}
class MiembroComunidad <<entity>> {
  - idMiembro : Long
  - idComunidad : Long
  - idUsuario : Long
  - rolComunidad : MiembroComunidadRolComunidad
  - estado : MiembroComunidadEstado
  - fechaIngreso : LocalDateTime
  - fechaSalida : LocalDateTime
}
class SolicitudIngreso <<entity>> {
  - idSolicitud : Long
  - idComunidad : Long
  - idUsuario : Long
  - estado : SolicitudIngresoEstado
  - mensaje : String
