@startuml
title CU05 Crear comunidad — Diseño
left to right direction
class ComunidadController {
  + list(filtros): Page
  + join(Long): MiembroComunidad
  + resolve(Long, Resolucion): SolicitudIngreso
}
class Requests <<DTO validado>>
interface ComunidadService {
  + buscar(filtros): Page<Comunidad>
  + guardar(Long, ComunidadDatos): Comunidad
  + unirse(Long): MiembroComunidad
  + solicitar(Long, Solicitud): SolicitudIngreso
  + resolver(Long, Resolucion): SolicitudIngreso
}
class ComunidadServiceImpl {
  + buscar(filtros): Page<Comunidad>
  + guardar(Long, ComunidadDatos): Comunidad
  + unirse(Long): MiembroComunidad
  + solicitar(Long, Solicitud): SolicitudIngreso
  + resolver(Long, Resolucion): SolicitudIngreso
  + salir(Long): void
  + expulsar(Long, Long): void
}
ComunidadServiceImpl ..|> ComunidadService
ComunidadController --> ComunidadService
ComunidadController ..> Requests
class AccessService {
  + member(Long): void
  + moderator(Long): void
  + teacher(Long): void
  + writableTeacher(Long): void
  + enrolled(Long): void
  + owner(Long): void
}
ComunidadServiceImpl --> AccessService
interface CategoriaRepository <<JpaRepository>> {
 + findById(Long): Optional<Categoria>
 + save(Categoria): Categoria
}
class Categoria <<entity>> {
  - idCategoria : Long
  - nombre : String
  - descripcion : String
}
ComunidadServiceImpl --> CategoriaRepository
CategoriaRepository ..> Categoria
interface UsuarioRepository <<JpaRepository>> {
 + findById(Long): Optional<Usuario>
 + save(Usuario): Usuario
}
class Usuario <<entity>> {
  - idUsuario : Long
  - idRol : Long
  - correo : String
  - nombres : String
  - apellidos : String
  - especialidad : String
  - keycloakSub : String
  - passwordHash : String
  - intentosFallidos : Long
  - bloqueadoHasta : LocalDateTime
  - idFotoPerfil : Long
  - idIdiomaPref : Long
  - estado : UsuarioEstado
  - fechaRegistro : LocalDateTime
  - fechaActualizacion : LocalDateTime
}
ComunidadServiceImpl --> UsuarioRepository
UsuarioRepository ..> Usuario
interface ArchivoRepository <<JpaRepository>> {
 + findById(Long): Optional<Archivo>
 + save(Archivo): Archivo
}
class Archivo <<entity>> {
  - idArchivo : Long
  - idSubidoPor : Long
  - nombreOriginal : String
  - extension : String
  - tipoMime : String
  - tamanoBytes : Long
  - rutaAlmacenamiento : String
  - fechaSubida : LocalDateTime
}
ComunidadServiceImpl --> ArchivoRepository
ArchivoRepository ..> Archivo
interface ComunidadRepository <<JpaRepository>> {
 + findById(Long): Optional<Comunidad>
 + save(Comunidad): Comunidad
}
class Comunidad <<entity>> {
  - idComunidad : Long
  - nombre : String
  - descripcion : String
  - idCategoria : Long
  - idIdioma : Long
  - idPueblo : Long
  - visibilidad : ComunidadVisibilidad
  - moderacionPrevia : Boolean
  - estado : ComunidadEstado
  - idImagen : Long
  - idCreador : Long
  - fechaCreacion : LocalDateTime
  - fechaActualizacion : LocalDateTime
}
ComunidadServiceImpl --> ComunidadRepository
ComunidadRepository ..> Comunidad
@enduml
