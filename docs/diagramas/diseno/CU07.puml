@startuml
title CU07 Gestionar publicaciones educativas — Diseño
left to right direction
class PublicacionController {
  + wall(Long): Page
  + create(Long, PublicacionDatos): PublicacionVista
  + comment(Long, ComentarioDatos): ComentarioVista
}
class Requests <<DTO validado>>
interface PublicacionService {
  + guardar(Long, Long, PublicacionDatos): Publicacion
  + moderar(Long, Moderacion): Publicacion
  + comentar(Long, ComentarioDatos): Comentario
}
class PublicacionServiceImpl {
  + visible(Long): Publicacion
  + guardar(Long, Long, PublicacionDatos): Publicacion
  + moderar(Long, Moderacion): Publicacion
  + comentar(Long, ComentarioDatos): Comentario
  + eliminar(Long): void
}
PublicacionServiceImpl ..|> PublicacionService
PublicacionController --> PublicacionService
PublicacionController ..> Requests
class AccessService {
  + member(Long): void
  + moderator(Long): void
  + teacher(Long): void
  + writableTeacher(Long): void
  + enrolled(Long): void
  + owner(Long): void
}
PublicacionServiceImpl --> AccessService
interface UsuarioRepository <<JpaRepository>> {
 + findById(Long): Optional<Usuario>
 + save(Usuario): Usuario
}
class Usuario <<entity>> {
  - idUsuario : Long
  - idRol : Long
  - correo : String
  - nombres : String
  - apellidos : String
  - especialidad : String
  - keycloakSub : String
  - passwordHash : String
  - intentosFallidos : Long
  - bloqueadoHasta : LocalDateTime
  - idFotoPerfil : Long
  - idIdiomaPref : Long
  - estado : UsuarioEstado
  - fechaRegistro : LocalDateTime
  - fechaActualizacion : LocalDateTime
}
PublicacionServiceImpl --> UsuarioRepository
UsuarioRepository ..> Usuario
interface ArchivoRepository <<JpaRepository>> {
 + findById(Long): Optional<Archivo>
 + save(Archivo): Archivo
}
class Archivo <<entity>> {
  - idArchivo : Long
  - idSubidoPor : Long
  - nombreOriginal : String
  - extension : String
  - tipoMime : String
  - tamanoBytes : Long
  - rutaAlmacenamiento : String
  - fechaSubida : LocalDateTime
}
PublicacionServiceImpl --> ArchivoRepository
ArchivoRepository ..> Archivo
interface PublicacionRepository <<JpaRepository>> {
 + findById(Long): Optional<Publicacion>
 + save(Publicacion): Publicacion
}
class Publicacion <<entity>> {
  - idPublicacion : Long
  - idComunidad : Long
  - idSeccion : Long
  - idAutor : Long
  - titulo : String
  - contenido : String
  - estado : PublicacionEstado
  - idModerador : Long
  - fechaModeracion : LocalDateTime
  - fechaPublicacion : LocalDateTime
  - fechaEdicion : LocalDateTime
  - eliminado : Boolean
}
PublicacionServiceImpl --> PublicacionRepository
PublicacionRepository ..> Publicacion
interface PublicacionArchivoRepository <<JpaRepository>> {
 + findById(Long): Optional<PublicacionArchivo>
 + save(PublicacionArchivo): PublicacionArchivo
}
class PublicacionArchivo <<entity>> {
  - idPublicacion : Long
  - idArchivo : Long
  - orden : Long
}
PublicacionServiceImpl --> PublicacionArchivoRepository
PublicacionArchivoRepository ..> PublicacionArchivo
interface ComentarioRepository <<JpaRepository>> {
 + findById(Long): Optional<Comentario>
 + save(Comentario): Comentario
}
class Comentario <<entity>> {
  - idComentario : Long
  - idPublicacion : Long
  - idRecurso : Long
  - idComentarioPadre : Long
  - idAutor : Long
  - contenido : String
  - fechaComentario : LocalDateTime
  - fechaEdicion : LocalDateTime
  - eliminado : Boolean
  - idEliminadoPor : Long
}
PublicacionServiceImpl --> ComentarioRepository
ComentarioRepository ..> Comentario
interface NotificacionRepository <<JpaRepository>> {
 + findById(Long): Optional<Notificacion>
 + save(Notificacion): Notificacion
}
class Notificacion <<entity>> {
  - idNotificacion : Long
  - idDestinatario : Long
  - idEmisor : Long
  - idComunidad : Long
  - tipo : NotificacionTipo
  - titulo : String
  - contenido : String
  - entidadTipo : String
  - entidadId : Long
  - leida : Boolean
  - fechaCreacion : LocalDateTime
  - fechaLectura : LocalDateTime
}
PublicacionServiceImpl --> NotificacionRepository
NotificacionRepository ..> Notificacion
@enduml
