@startuml
title CU03 Buscar comunidades — Diseño
left to right direction
class ComunidadController {
  + list(filtros): Page
  + join(Long): MiembroComunidad
  + resolve(Long, Resolucion): SolicitudIngreso
}
class Requests <<DTO validado>>
interface ComunidadService {
  + buscar(filtros): Page<Comunidad>
  + guardar(Long, ComunidadDatos): Comunidad
  + unirse(Long): MiembroComunidad
  + solicitar(Long, Solicitud): SolicitudIngreso
  + resolver(Long, Resolucion): SolicitudIngreso
}
class ComunidadServiceImpl {
  + buscar(filtros): Page<Comunidad>
  + guardar(Long, ComunidadDatos): Comunidad
  + unirse(Long): MiembroComunidad
  + solicitar(Long, Solicitud): SolicitudIngreso
  + resolver(Long, Resolucion): SolicitudIngreso
  + salir(Long): void
  + expulsar(Long, Long): void
}
ComunidadServiceImpl ..|> ComunidadService
ComunidadController --> ComunidadService
ComunidadController ..> Requests
class AccessService {
  + member(Long): void
  + moderator(Long): void
  + teacher(Long): void
  + writableTeacher(Long): void
  + enrolled(Long): void
  + owner(Long): void
}
ComunidadServiceImpl --> AccessService
interface CategoriaRepository <<JpaRepository>> {
 + findById(Long): Optional<Categoria>
 + save(Categoria): Categoria
}
class Categoria <<entity>> {
  - idCategoria : Long
  - nombre : String
  - descripcion : String
}
ComunidadServiceImpl --> CategoriaRepository
CategoriaRepository ..> Categoria
interface IdiomaRepository <<JpaRepository>> {
 + findById(Long): Optional<Idioma>
 + save(Idioma): Idioma
}
class Idioma <<entity>> {
  - idIdioma : Long
  - codigo : String
  - nombre : String
}
ComunidadServiceImpl --> IdiomaRepository
IdiomaRepository ..> Idioma
interface PuebloOriginarioRepository <<JpaRepository>> {
 + findById(Long): Optional<PuebloOriginario>
 + save(PuebloOriginario): PuebloOriginario
}
class PuebloOriginario <<entity>> {
  - idPueblo : Long
  - nombre : String
  - familiaLinguistica : String
}
ComunidadServiceImpl --> PuebloOriginarioRepository
PuebloOriginarioRepository ..> PuebloOriginario
interface ComunidadRepository <<JpaRepository>> {
 + findById(Long): Optional<Comunidad>
 + save(Comunidad): Comunidad
}
class Comunidad <<entity>> {
  - idComunidad : Long
  - nombre : String
  - descripcion : String
  - idCategoria : Long
  - idIdioma : Long
  - idPueblo : Long
  - visibilidad : ComunidadVisibilidad
  - moderacionPrevia : Boolean
  - estado : ComunidadEstado
  - idImagen : Long
  - idCreador : Long
  - fechaCreacion : LocalDateTime
  - fechaActualizacion : LocalDateTime
}
ComunidadServiceImpl --> ComunidadRepository
ComunidadRepository ..> Comunidad
@enduml
