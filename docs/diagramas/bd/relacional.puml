COMUNIDAD }o--|| PUEBLO_ORIGINARIO : id_pueblo
COMUNIDAD }o--|| ARCHIVO : id_imagen
COMUNIDAD }o--|| USUARIO : id_creador
MIEMBRO_COMUNIDAD }o--|| COMUNIDAD : id_comunidad
MIEMBRO_COMUNIDAD }o--|| USUARIO : id_usuario
SOLICITUD_INGRESO }o--|| COMUNIDAD : id_comunidad
SOLICITUD_INGRESO }o--|| USUARIO : id_usuario
SOLICITUD_INGRESO }o--|| USUARIO : id_revisor
CURSO }o--|| COMUNIDAD : id_comunidad
SECCION }o--|| CURSO : id_curso
SECCION }o--|| PERIODO_ACADEMICO : id_periodo
SECCION }o--|| USUARIO : id_docente
UNIDAD }o--|| SECCION : id_seccion
SESION }o--|| UNIDAD : id_unidad
RECURSO }o--|| UNIDAD : id_unidad
RECURSO }o--|| SESION : id_sesion
RECURSO }o--|| USUARIO : id_autor
RECURSO }o--|| IDIOMA : id_idioma
RECURSO }o--|| ARCHIVO : id_archivo
EVENTO }o--|| COMUNIDAD : id_comunidad
EVENTO }o--|| SECCION : id_seccion
EVENTO }o--|| USUARIO : id_creador
MATRICULA }o--|| SECCION : id_seccion
MATRICULA }o--|| USUARIO : id_usuario
EVALUACION }o--|| SECCION : id_seccion
EVALUACION }o--|| UNIDAD : id_unidad
TAREA }o--|| RECURSO : id_recurso
TAREA }o--|| EVALUACION : id_evaluacion
ENTREGA_TAREA }o--|| TAREA : id_recurso
ENTREGA_TAREA }o--|| MATRICULA : id_matricula
ENTREGA_TAREA }o--|| ARCHIVO : id_archivo
NOTA }o--|| MATRICULA : id_matricula
NOTA }o--|| EVALUACION : id_evaluacion
NOTA }o--|| USUARIO : id_registrado_por
ASISTENCIA }o--|| SESION : id_sesion
ASISTENCIA }o--|| MATRICULA : id_matricula
ASISTENCIA }o--|| USUARIO : id_registrado_por
PUBLICACION }o--|| COMUNIDAD : id_comunidad
PUBLICACION }o--|| SECCION : id_seccion
PUBLICACION }o--|| USUARIO : id_autor
PUBLICACION }o--|| USUARIO : id_moderador
PUBLICACION_ARCHIVO }o--|| PUBLICACION : id_publicacion
PUBLICACION_ARCHIVO }o--|| ARCHIVO : id_archivo
COMENTARIO }o--|| PUBLICACION : id_publicacion
COMENTARIO }o--|| RECURSO : id_recurso
COMENTARIO }o--|| COMENTARIO : id_comentario_padre
COMENTARIO }o--|| USUARIO : id_autor
COMENTARIO }o--|| USUARIO : id_eliminado_por
NOTIFICACION }o--|| USUARIO : id_destinatario
NOTIFICACION }o--|| USUARIO : id_emisor
NOTIFICACION }o--|| COMUNIDAD : id_comunidad
MENSAJE }o--|| USUARIO : id_emisor
MENSAJE }o--|| USUARIO : id_receptor
