@startuml
title Modelo relacional — 28 tablas Oracle
hide methods
entity ROL {
 * id_rol : NUMBER (IDENTITY)
 codigo : VARCHAR2(20)
 nombre : VARCHAR2(50)
}
entity CATEGORIA {
 * id_categoria : NUMBER (IDENTITY)
 nombre : VARCHAR2(100)
 descripcion : VARCHAR2(500)
}
entity IDIOMA {
 * id_idioma : NUMBER (IDENTITY)
 codigo : VARCHAR2(10)
 nombre : VARCHAR2(60)
}
entity PUEBLO_ORIGINARIO {
 * id_pueblo : NUMBER (IDENTITY)
 nombre : VARCHAR2(100)
 familia_linguistica : VARCHAR2(100)
}
entity USUARIO {
 * id_usuario : NUMBER (IDENTITY)
 id_rol : NUMBER <<FK>>
 correo : VARCHAR2(150)
 nombres : VARCHAR2(100)
 apellidos : VARCHAR2(100)
 especialidad : VARCHAR2(100)
 keycloak_sub : VARCHAR2(64)
 password_hash : VARCHAR2(255)
 intentos_fallidos : NUMBER(2)
 bloqueado_hasta : TIMESTAMP
 id_foto_perfil : NUMBER
 id_idioma_pref : NUMBER <<FK>>
 estado : VARCHAR2(10)
 fecha_registro : TIMESTAMP
 fecha_actualizacion : TIMESTAMP
}
entity ARCHIVO {
 * id_archivo : NUMBER (IDENTITY)
 id_subido_por : NUMBER <<FK>>
 nombre_original : VARCHAR2(255)
 extension : VARCHAR2(10)
 tipo_mime : VARCHAR2(100)
 tamano_bytes : NUMBER
 ruta_almacenamiento : VARCHAR2(500)
 fecha_subida : TIMESTAMP
}
entity COMUNIDAD {
 * id_comunidad : NUMBER (IDENTITY)
 nombre : VARCHAR2(150)
 descripcion : VARCHAR2(1000)
 id_categoria : NUMBER <<FK>>
 id_idioma : NUMBER <<FK>>
 id_pueblo : NUMBER <<FK>>
 visibilidad : VARCHAR2(10)
 moderacion_previa : NUMBER(1)
 estado : VARCHAR2(10)
 id_imagen : NUMBER <<FK>>
 id_creador : NUMBER <<FK>>
 fecha_creacion : TIMESTAMP
 fecha_actualizacion : TIMESTAMP
}
entity MIEMBRO_COMUNIDAD {
 * id_miembro : NUMBER (IDENTITY)
 id_comunidad : NUMBER <<FK>>
 id_usuario : NUMBER <<FK>>
 rol_comunidad : VARCHAR2(15)
 estado : VARCHAR2(10)
 fecha_ingreso : TIMESTAMP
 fecha_salida : TIMESTAMP
}
entity SOLICITUD_INGRESO {
 * id_solicitud : NUMBER (IDENTITY)
 id_comunidad : NUMBER <<FK>>
 id_usuario : NUMBER <<FK>>
 estado : VARCHAR2(10)
 mensaje : VARCHAR2(500)
 fecha_solicitud : TIMESTAMP
 id_revisor : NUMBER <<FK>>
 fecha_respuesta : TIMESTAMP
 motivo_rechazo : VARCHAR2(500)
}
entity PERIODO_ACADEMICO {
 * id_periodo : NUMBER (IDENTITY)
 nombre : VARCHAR2(20)
 fecha_inicio : DATE
 fecha_fin : DATE
 estado : VARCHAR2(12)
}
entity CURSO {
 * id_curso : NUMBER (IDENTITY)
 id_comunidad : NUMBER <<FK>>
 codigo : VARCHAR2(20)
 nombre : VARCHAR2(150)
 descripcion : VARCHAR2(1000)
 estado : VARCHAR2(10)
 fecha_creacion : TIMESTAMP
}
entity SECCION {
 * id_seccion : NUMBER (IDENTITY)
 id_curso : NUMBER <<FK>>
 id_periodo : NUMBER <<FK>>
 id_docente : NUMBER <<FK>>
 grupo : VARCHAR2(10)
 cupo_maximo : NUMBER(4)
 sala_virtual : VARCHAR2(500)
 estado : VARCHAR2(10)
}
entity UNIDAD {
 * id_unidad : NUMBER (IDENTITY)
 id_seccion : NUMBER <<FK>>
 nombre : VARCHAR2(150)
 descripcion : VARCHAR2(1000)
 orden : NUMBER(3)
}
entity SESION {
 * id_sesion : NUMBER (IDENTITY)
 id_unidad : NUMBER <<FK>>
 titulo : VARCHAR2(200)
 orden : NUMBER(3)
 fecha_inicio : TIMESTAMP
 duracion_min : NUMBER(4)
 enlace_clase : VARCHAR2(500)
}
entity RECURSO {
 * id_recurso : NUMBER (IDENTITY)
 id_unidad : NUMBER <<FK>>
 id_sesion : NUMBER <<FK>>
 id_autor : NUMBER <<FK>>
 titulo : VARCHAR2(200)
 descripcion : VARCHAR2(1000)
 tipo : VARCHAR2(10)
 id_idioma : NUMBER <<FK>>
 id_archivo : NUMBER <<FK>>
 url_externa : VARCHAR2(500)
 fecha_publicacion : TIMESTAMP
 eliminado : NUMBER(1)
 fecha_eliminacion : TIMESTAMP
}
entity EVENTO {
 * id_evento : NUMBER (IDENTITY)
 id_comunidad : NUMBER <<FK>>
 id_seccion : NUMBER <<FK>>
 id_creador : NUMBER <<FK>>
 titulo : VARCHAR2(200)
 descripcion : VARCHAR2(1000)
 fecha_inicio : TIMESTAMP
 fecha_fin : TIMESTAMP
 enlace : VARCHAR2(500)
}
entity MATRICULA {
 * id_matricula : NUMBER (IDENTITY)
 id_seccion : NUMBER <<FK>>
 id_usuario : NUMBER <<FK>>
 fecha_matricula : TIMESTAMP
 estado : VARCHAR2(12)
 nota_final : NUMBER(4,2)
 fecha_retiro : TIMESTAMP
}
entity EVALUACION {
 * id_evaluacion : NUMBER (IDENTITY)
 id_seccion : NUMBER <<FK>>
 id_unidad : NUMBER <<FK>>
 nombre : VARCHAR2(100)
 tipo : VARCHAR2(15)
 peso : NUMBER(5,2)
 fecha : TIMESTAMP
}
entity TAREA {
 * id_recurso : NUMBER <<FK>>
 fecha_entrega : TIMESTAMP
 permite_tardias : NUMBER(1)
 id_evaluacion : NUMBER <<FK>>
}
entity ENTREGA_TAREA {
 * id_entrega : NUMBER (IDENTITY)
 id_recurso : NUMBER <<FK>>
 id_matricula : NUMBER <<FK>>
 id_archivo : NUMBER <<FK>>
 comentario : VARCHAR2(1000)
 fecha_entrega : TIMESTAMP
 estado : VARCHAR2(10)
}
entity NOTA {
 * id_nota : NUMBER (IDENTITY)
 id_matricula : NUMBER <<FK>>
 id_evaluacion : NUMBER <<FK>>
 calificacion : NUMBER(4,2)
 comentario_docente : VARCHAR2(1000)
 id_registrado_por : NUMBER <<FK>>
 fecha_registro : TIMESTAMP
 fecha_modificacion : TIMESTAMP
}
entity ASISTENCIA {
 * id_asistencia : NUMBER (IDENTITY)
 id_sesion : NUMBER <<FK>>
 id_matricula : NUMBER <<FK>>
 estado : VARCHAR2(12)
 observacion : VARCHAR2(300)
 id_registrado_por : NUMBER <<FK>>
 fecha_registro : TIMESTAMP
}
entity PUBLICACION {
 * id_publicacion : NUMBER (IDENTITY)
 id_comunidad : NUMBER <<FK>>
 id_seccion : NUMBER <<FK>>
 id_autor : NUMBER <<FK>>
 titulo : VARCHAR2(200)
 contenido : CLOB
 estado : VARCHAR2(10)
 id_moderador : NUMBER <<FK>>
 fecha_moderacion : TIMESTAMP
 fecha_publicacion : TIMESTAMP
 fecha_edicion : TIMESTAMP
 eliminado : NUMBER(1)
}
entity PUBLICACION_ARCHIVO {
 * id_publicacion : NUMBER <<FK>>
 * id_archivo : NUMBER <<FK>>
 orden : NUMBER(2)
}
entity COMENTARIO {
 * id_comentario : NUMBER (IDENTITY)
 id_publicacion : NUMBER <<FK>>
 id_recurso : NUMBER <<FK>>
 id_comentario_padre : NUMBER <<FK>>
 id_autor : NUMBER <<FK>>
 contenido : VARCHAR2(2000)
 fecha_comentario : TIMESTAMP
 fecha_edicion : TIMESTAMP
 eliminado : NUMBER(1)
 id_eliminado_por : NUMBER <<FK>>
}
entity NOTIFICACION {
 * id_notificacion : NUMBER (IDENTITY)
 id_destinatario : NUMBER <<FK>>
 id_emisor : NUMBER <<FK>>
 id_comunidad : NUMBER <<FK>>
 tipo : VARCHAR2(30)
 titulo : VARCHAR2(200)
 contenido : VARCHAR2(500)
 entidad_tipo : VARCHAR2(30)
 entidad_id : NUMBER
 leida : NUMBER(1)
 fecha_creacion : TIMESTAMP
 fecha_lectura : TIMESTAMP
}
entity MENSAJE {
 * id_mensaje : NUMBER (IDENTITY)
 id_emisor : NUMBER <<FK>>
 id_receptor : NUMBER <<FK>>
 contenido : VARCHAR2(4000)
 leido : NUMBER(1)
 fecha_envio : TIMESTAMP
 eliminado : NUMBER(1)
}
entity AUDITORIA {
 * id_auditoria : NUMBER (IDENTITY)
 tabla : VARCHAR2(30)
 id_registro : NUMBER
 accion : VARCHAR2(10)
 id_usuario : NUMBER <<FK>>
 fecha : TIMESTAMP
 valores_antes : CLOB
 valores_despues : CLOB
}
USUARIO }o--|| ROL : id_rol
USUARIO }o--|| IDIOMA : id_idioma_pref
