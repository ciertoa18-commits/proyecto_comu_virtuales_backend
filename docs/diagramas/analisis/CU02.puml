@startuml
title CU02 Gestionar perfil de usuario — Análisis
left to right direction
skinparam classAttributeIconSize 0
class "Interfaz Gestionar perfil de usuario" as Boundary <<boundary>>
class "Control Gestionar perfil de usuario" as Control <<control>>
Boundary --> Control
class Idioma <<entity>> {
  - idIdioma : Long
  - codigo : String
  - nombre : String
}
Control --> Idioma
class Usuario <<entity>> {
  - idUsuario : Long
  - idRol : Long
  - correo : String
  - nombres : String
  - apellidos : String
  - especialidad : String
  - keycloakSub : String
  - passwordHash : String
  - intentosFallidos : Long
  - bloqueadoHasta : LocalDateTime
  - idFotoPerfil : Long
  - idIdiomaPref : Long
  - estado : UsuarioEstado
  - fechaRegistro : LocalDateTime
  - fechaActualizacion : LocalDateTime
}
Control --> Usuario
class Archivo <<entity>> {
  - idArchivo : Long
  - idSubidoPor : Long
  - nombreOriginal : String
  - extension : String
  - tipoMime : String
  - tamanoBytes : Long
  - rutaAlmacenamiento : String
  - fechaSubida : LocalDateTime
}
Control --> Archivo
Usuario "*" --> "0..1" Idioma : id_idioma_pref
Archivo "*" --> "1" Usuario : id_subido_por
@enduml
